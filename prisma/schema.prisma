generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum AccountType {
  CASH
  BANK
  SAVINGS
  CREDIT_CARD
  INVESTMENT
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String
  defaultCurrency String   @default("LKR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts     Account[]
  categories   Category[]
  tags         Tag[]
  transactions Transaction[]
}

/// Amounts are stored in minor units (cents).
model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType @default(CASH)
  currency       String
  initialBalance Int         @default(0)
  color          String
  note           String      @default("")
  archived       Boolean     @default(false)
  createdAt      DateTime    @default(now())

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[] @relation("SourceAccount")
  incomingTransfers Transaction[] @relation("DestinationAccount")

  @@index([userId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  type      CategoryType
  color     String
  createdAt DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, type, name])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

/// `date` is stored at 12:00 UTC of the calendar day the user picked.
/// For transfers, `amount` leaves `account` and `toAmount` arrives in `toAccount`.
model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Int
  accountId   String
  toAccountId String?
  toAmount    Int?
  categoryId  String?
  date        DateTime
  note        String          @default("")
  createdAt   DateTime        @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account   @relation("SourceAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccount Account?  @relation("DestinationAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags      Tag[]

  @@index([userId, date])
  @@index([accountId])
  @@index([toAccountId])
}
