# Supabase project. Find both under Project Settings > API Keys in the dashboard.
# The secret key bypasses row level security: keep it server-side only.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me"
