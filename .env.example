# Supabase project. Find both under Project Settings > API Keys in the dashboard.
# The secret key bypasses row level security: keep it server-side only.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me"
# Local only. `npm run db:seed` refuses to run unless this is 1, because it creates the
# demo@nihi.app user with a known password in the database above (production refuses that login).
# Run it as: ALLOW_DEMO_SEED=1 npm run db:seed
# ALLOW_DEMO_SEED=1
