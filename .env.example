# Supabase project. Find both under Project Settings > API Keys in the dashboard.
# The secret key bypasses row level security: keep it server-side only.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me"
# Local only. `npm run db:seed` refuses to run unless this is 1, because it creates the
# demo@nihi.app user with a known password in the database above (production refuses that login).
# Run it as: ALLOW_DEMO_SEED=1 npm run db:seed
# ALLOW_DEMO_SEED=1

# Optional: emails the partner invite itself. Without these, the invite page shows a link to copy
# and a "Send via Gmail" button that opens a ready-made message instead.
# For Gmail, SMTP_USER is your Gmail address and SMTP_PASSWORD is an APP PASSWORD, not your normal password:
# Google Account > Security > turn on 2-Step Verification > App passwords > create one for "NiHi".
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="abcd efgh ijkl mnop"
# Other providers: also set SMTP_HOST (default smtp.gmail.com) and SMTP_PORT (default 465).
# MAIL_FROM="NiHi <you@gmail.com>"

# Optional: where server errors are sent (a Slack/Discord-style webhook that accepts JSON). Without it errors only go to the server log.
# ERROR_WEBHOOK_URL="https://hooks.example.com/..."
